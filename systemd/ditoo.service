[Unit]
Description=Divoom Ditoo Pro Desktop Notification Daemon
After=bluetooth.target sound.target

[Service]
Type=simple
# Cleanly skips execution if no Ditoo device is paired on this machine
ExecCondition=%h/.local/bin/ditoo-notification-daemon --check
ExecStart=%h/.local/bin/ditoo-notification-daemon
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
